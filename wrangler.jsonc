{
  "name": "vicharhub",
  "compatibility_date": "2026-08-12",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vicharhub-db",
      "database_id": "5acb36cd-5cc7-4a74-be5b-cbba0e77cc23"
    }
  ],
  "observability": {
    "enabled": true
  }
}
